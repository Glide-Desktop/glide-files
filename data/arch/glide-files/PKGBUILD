pkgname=glide-files
pkgver=0.1.r164.g36be2e4
pkgrel=1
pkgdesc="File manager of the Glide desktop"
arch=(x86_64)
url="https://github.com/Glide-Desktop/glide-files"
license=(GPL-3.0-or-later)
depends=(
    glibc gcc-libs libglvnd vulkan-icd-loader wayland libxkbcommon hicolor-icon-theme
    glide-configd dbus glib2 shared-mime-info xdg-utils
    libarchive udisks2 ntfs-3g gvfs gvfs-mtp gvfs-gphoto2
)
optdepends=(
    'glide-terminal: Open in Terminal and Run in Terminal'
    'xdg-desktop-portal-glide: the file chooser of every app'
    'jmtpfs: phones when gvfs is not running'
)
makedepends=(git cargo pkgconf)
options=(!lto !debug)
_git="${GLIDE_GIT:-https://github.com/Glide-Desktop}"
_target="${GLIDE_CARGO_TARGET:-target}"
source=("$pkgname::git+$_git/glide-files")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    if tag="$(git describe --long --tags --abbrev=7 2>/dev/null)"; then
        printf '%s' "$tag" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$_target"
    cargo build --frozen --release -p glide-files
}

package() {
    cd "$pkgname"
    install -Dm755 $_target/release/glide-files "$pkgdir/usr/bin/glide-files"
    install -Dm644 data/glide-files.desktop "$pkgdir/usr/share/applications/glide-files.desktop"
    install -Dm644 data/glide-files-search-provider.ini \
        "$pkgdir/usr/share/gnome-shell/search-providers/glide-files-search-provider.ini"
    install -d "$pkgdir/usr/share/dbus-1/services"
    sed 's|^Exec=.*/glide-files|Exec=/usr/bin/glide-files|' data/org.glide.Files.service \
        > "$pkgdir/usr/share/dbus-1/services/org.glide.Files.service"
    chmod 644 "$pkgdir/usr/share/dbus-1/services/org.glide.Files.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
